{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PowerNext_Physics_Request_v2",
  "title": "Reference Physics Request, SI units",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configuration",
    "setup"
  ],
  "properties": {
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "impulse_type",
        "stages",
        "stage_charge_V",
        "front_per_stage_ohm",
        "tail_per_stage_ohm",
        "topology_id",
        "recipe_id"
      ],
      "properties": {
        "impulse_type": {
          "enum": [
            "LI",
            "SI"
          ]
        },
        "stages": {
          "type": "integer",
          "minimum": 2,
          "maximum": 15
        },
        "stage_charge_V": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200000
        },
        "front_per_stage_ohm": {
          "enum": [
            30,
            46,
            180,
            520,
            3700,
            5000
          ]
        },
        "tail_per_stage_ohm": {
          "enum": [
            30,
            46,
            180,
            520,
            3700,
            5000
          ]
        },
        "topology_id": {
          "enum": [
            "GSHUNT_v0",
            "OSHUNT_v0"
          ]
        },
        "polarity": {
          "enum": [
            -1,
            1
          ],
          "default": 1
        },
        "recipe_id": {
          "enum": [
            "DEV_UNIFORM_SINGLE_v2",
            "HYP_LI_TAIL_180_PAR_520_v1"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recipe_id": {
                "const": "HYP_LI_TAIL_180_PAR_520_v1"
              }
            }
          },
          "then": {
            "properties": {
              "impulse_type": {
                "const": "LI"
              },
              "topology_id": {
                "const": "GSHUNT_v0"
              },
              "tail_per_stage_ohm": {
                "const": 180
              }
            }
          }
        }
      ]
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dut_capacitance_F",
        "divider_capacitance_F",
        "stray_capacitance_F",
        "loop_inductance_H",
        "basic_coverage_assumption"
      ],
      "properties": {
        "dut_capacitance_F": {
          "type": "number",
          "minimum": 0
        },
        "divider_capacitance_F": {
          "type": "number",
          "minimum": 0
        },
        "stray_capacitance_F": {
          "type": "number",
          "minimum": 0
        },
        "loop_inductance_H": {
          "type": "number",
          "minimum": 0
        },
        "loop_resistance_ohm": {
          "type": "number",
          "minimum": 0
        },
        "load_resistance_ohm": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "basic_coverage_assumption": {
          "enum": [
            "ADDITIONAL_DISJOINT",
            "INCLUDED_IN_OTHER_COMPONENTS"
          ]
        },
        "setup_id": {
          "type": "string"
        },
        "auxiliary_assumption": {
          "const": "UNCONFIRMED_AUXILIARY_BRANCHES_OMITTED"
        }
      }
    },
    "target_crest_V": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    }
  }
}
